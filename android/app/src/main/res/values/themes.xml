<resources>
	<style name="Theme.Tnt" parent="Theme.Material3.Light.NoActionBar">
		<item name="colorPrimary">@color/tnt_main</item>
		<item name="colorOnPrimary">@android:color/white</item>
		<item name="android:statusBarColor">@android:color/transparent</item>
		<item name="android:navigationBarColor">@android:color/transparent</item>
	</style>

	<style name="Theme.Tnt.Dialog" parent="Theme.Material3.Light.Dialog">
		<item name="colorPrimary">@color/tnt_main</item>
		<item name="colorOnPrimary">@android:color/white</item>
		<item name="android:windowBackground">@drawable/bg_card</item>
		<item name="android:windowSoftInputMode">adjustResize</item>
	</style>

	<style name="Tnt.Title" parent="">
		<item name="android:textSize">25sp</item>
		<item name="android:textStyle">bold</item>
		<item name="android:textColor">@android:color/black</item>
		<item name="android:gravity">center</item>
		<item name="android:layout_marginTop">10dp</item>
		<item name="android:layout_marginBottom">15dp</item>
	</style>
</resources>
