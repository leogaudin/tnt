#!/usr/bin/env bash
# Builds the mobile app for one country.
#
#   ./assemble <release|debug> <country> [--ios] [--open]
#
# By default this builds the native Kotlin Android app (android/). --ios builds the native Swift iOS app (ios/)
# instead: debug for the simulator, release as an .xcarchive (nothing is exported or uploaded).
#
# The country is a folder of mobile/countries/ (e.g. malawi, rwanda). In a
# standalone export the country argument is optional (mobile/countries/default.json).
# Output: dist/mobile/<country>-<version>-<mode>.(apk|app|xcarchive)
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
COUNTRIES="$ROOT/mobile/countries"

available() {
	for d in "$COUNTRIES"/*/; do
		name="$(basename "$d")"
		[ -f "$d/config.json" ] && echo "  $name"
	done
}

usage() {
	cat >&2 <<USAGE
Usage: ./assemble <release|debug> <country> [--ios] [--open]

Available countries:
$(available)
USAGE
	exit 1
}

MODE=""
COUNTRY=""
OPEN=0
IOS=0
for arg in "$@"; do
	case "$arg" in
		--ios) IOS=1 ;;
		--open) OPEN=1 ;;
		-h|--help) usage ;;
		--*) echo "Unknown option: $arg" >&2; usage ;;
		*)
			if [ -z "$MODE" ]; then MODE="$arg"
			elif [ -z "$COUNTRY" ]; then COUNTRY="$arg"
			else echo "Too many arguments" >&2; usage; fi
			;;
	esac
done

case "$MODE" in
	release|debug) ;;
	ios) echo "Use --ios: ./assemble <release|debug> <country> --ios" >&2; exit 1 ;;
	*) usage ;;
esac

DEFAULT_COUNTRY="$(node -p "require('$COUNTRIES/default.json').country")"
if [ -z "$COUNTRY" ]; then
	if [ "$DEFAULT_COUNTRY" = "_default" ]; then
		echo "Missing country." >&2
		usage
	fi
	COUNTRY="$DEFAULT_COUNTRY"
fi

if [ ! -f "$COUNTRIES/$COUNTRY/config.json" ]; then
	echo "Unknown country: $COUNTRY" >&2
	usage
fi

if [ "$MODE" = "release" ] && [ "$COUNTRY" = "_default" ]; then
	echo "_default is the test/development config and has no store listing: build it with 'debug'." >&2
	exit 1
fi

# One version for both apps.
VERSION="$(node -p "require('$ROOT/android/version.json').version")"

if [ "$IOS" = 1 ]; then
	echo "Building $COUNTRY $VERSION ($MODE, iOS)"
	"$ROOT/ios/configure.sh" "$COUNTRY"
	IOS_BUILD="$ROOT/ios/build"
	mkdir -p "$ROOT/dist/mobile"
	if [ "$MODE" = "debug" ]; then
		(cd "$ROOT/ios" && xcodebuild build -project TnT.xcodeproj -scheme TnT -configuration Debug \
			-destination 'generic/platform=iOS Simulator' -derivedDataPath "$IOS_BUILD" CODE_SIGNING_ALLOWED=NO)
		DEST="$ROOT/dist/mobile/$COUNTRY-$VERSION-debug.app"
		rm -rf "$DEST"
		cp -R "$IOS_BUILD/Build/Products/Debug-iphonesimulator/TnT.app" "$DEST"
	else
		DEST="$ROOT/dist/mobile/$COUNTRY-$VERSION-release.xcarchive"
		rm -rf "$DEST"
		(cd "$ROOT/ios" && xcodebuild archive -project TnT.xcodeproj -scheme TnT -configuration Release \
			-destination 'generic/platform=iOS' -archivePath "$DEST" -derivedDataPath "$IOS_BUILD" \
			-allowProvisioningUpdates)
	fi
	echo "Built: $DEST"
	[ "$OPEN" = 1 ] && open "$(dirname "$DEST")" || true
	exit 0
fi

MODE_CAP="$(echo "${MODE:0:1}" | tr '[:lower:]' '[:upper:]')${MODE:1}"

echo "Building $COUNTRY $VERSION ($MODE, Android)"
GRADLE_DIR="$ROOT/android"
(cd "$GRADLE_DIR" && ./gradlew clean "assemble${MODE_CAP}" -PtntCountry="$COUNTRY")

OUT_DIR="app/build/outputs/apk/$MODE"
SRC="$(ls "$GRADLE_DIR/$OUT_DIR"/*.apk 2>/dev/null | head -1 || true)"
if [ -z "$SRC" ]; then
	echo "Build finished but no .apk was found in $GRADLE_DIR/$OUT_DIR" >&2
	exit 1
fi

mkdir -p "$ROOT/dist/mobile"
DEST="$ROOT/dist/mobile/$COUNTRY-$VERSION-$MODE.apk"
cp "$SRC" "$DEST"
echo "Built: $DEST"
[ "$OPEN" = 1 ] && open "$(dirname "$DEST")" || true
